+            val results = CopyOnWriteArrayList<BootAssetCache.Result>()
+            val threads = (1..2).map { index ->
+                Thread({ results += cache.resolve(batchUrl) }, "boot-asset-cache-race-$index")
+            }
+            threads.forEach(Thread::start)
