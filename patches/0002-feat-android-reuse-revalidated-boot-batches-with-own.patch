+        val result = newCache(ScriptedFetcher { _, _ -> modified(etag = null) }).use { it.resolve(batchUrl) }
+
+        assertTrue(result is BootAssetCache.Result.Body)
+        assertNull(store.entry(key))
+    }
+
+    @Test
