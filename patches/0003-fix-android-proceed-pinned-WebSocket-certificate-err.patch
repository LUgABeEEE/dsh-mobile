diff --git a/apps/mobile/android/app/src/main/java/io/github/sayach/dshmobile/GatewayUrlPolicy.kt b/apps/mobile/android/app/src/main/java/io/github/sayach/dshmobile/GatewayUrlPolicy.kt
index d818c18..ffb9a0e 100644
--- a/apps/mobile/android/app/src/main/java/io/github/sayach/dshmobile/GatewayUrlPolicy.kt
+++ b/apps/mobile/android/app/src/main/java/io/github/sayach/dshmobile/GatewayUrlPolicy.kt
@@ -110,6 +110,24 @@ internal object GatewayUrlPolicy {
         return GatewayOrigin.fromCandidate(candidate) == origin
     }
 
+    /**
+     * Returns whether a URL addresses the configured gateway over a secure scheme.
+     *
+     * Chromium reports WebSocket certificate errors to `onReceivedSslError` with a `wss:` URL while
+     * the pinned origin is canonicalized as `https:`, so [isSameOrigin] rejects the very channel a
+     * paired page needs and cancels its document. Only the secure scheme family may differ — host
+     * and port still have to match exactly.
+     */
+    fun isPinnedAuthority(origin: GatewayOrigin, rawCandidate: String): Boolean {
+        val candidate = parseCandidate(rawCandidate) ?: return false
+        if (candidate.scheme?.lowercase() !in PINNED_SCHEMES) return false
+        if (candidate.rawUserInfo != null) return false
+        val port = if (candidate.port == -1) DEFAULT_HTTPS_PORT else candidate.port
+        if (port != origin.port) return false
+        val host = candidate.host?.lowercase()?.removePrefix("[")?.removeSuffix("]") ?: return false
+        return host == origin.host
+    }
+
     /** Returns whether a URL may be handed to a system browser. */
     fun isExternalHttps(rawCandidate: String): Boolean {
         val candidate = parseCandidate(rawCandidate) ?: return false
@@ -142,4 +160,7 @@ internal object GatewayUrlPolicy {
     }
 
     private fun parseCandidate(rawValue: String): URI? = runCatching { URI(rawValue) }.getOrNull()
+
+    private val PINNED_SCHEMES = setOf("https", "wss")
+    private const val DEFAULT_HTTPS_PORT = 443
 }
diff --git a/apps/mobile/android/app/src/main/java/io/github/sayach/dshmobile/SecureWebViewClient.kt b/apps/mobile/android/app/src/main/java/io/github/sayach/dshmobile/SecureWebViewClient.kt
index 56b9e66..e459bae 100644
--- a/apps/mobile/android/app/src/main/java/io/github/sayach/dshmobile/SecureWebViewClient.kt
+++ b/apps/mobile/android/app/src/main/java/io/github/sayach/dshmobile/SecureWebViewClient.kt
@@ -130,8 +130,11 @@ internal class SecureWebViewClient(
     }
 
     override fun onReceivedSslError(view: WebView, handler: SslErrorHandler, error: SslError) {
+        // A WebSocket handshake reaches this callback with a `wss:` URL, so an exact `https:`
+        // origin check rejects the page's own stream channel and cancels the document it belongs
+        // to. Host and port must still match exactly, and the leaf must pin.
         val pinned = caCertificate != null && error.primaryError == SslError.SSL_UNTRUSTED
-            && GatewayUrlPolicy.isSameOrigin(origin, error.url)
+            && GatewayUrlPolicy.isPinnedAuthority(origin, error.url)
             && PinnedTls.acceptsWebViewLeaf(origin, caCertificate, error.certificate.x509Certificate)
         if (pinned) {
             handler.proceed()
diff --git a/apps/mobile/android/app/src/test/java/io/github/sayach/dshmobile/GatewayUrlPolicyWebSocketTest.kt b/apps/mobile/android/app/src/test/java/io/github/sayach/dshmobile/GatewayUrlPolicyWebSocketTest.kt
new file mode 100644
index 0000000..5ef5470
--- /dev/null
+++ b/apps/mobile/android/app/src/test/java/io/github/sayach/dshmobile/GatewayUrlPolicyWebSocketTest.kt
@@ -0,0 +1,75 @@
+package io.github.sayach.dshmobile
+
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertNotNull
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+/**
+ * `onReceivedSslError` answers certificate errors for `wss:` handshakes as well as `https:`
+ * subresources, so the pinned-authority check must accept the secure WebSocket scheme without
+ * widening host or port.
+ */
+class GatewayUrlPolicyWebSocketTest {
+    private val origin = requireNotNull(GatewayOrigin.parse("https://192.168.1.11:3443"))
+
+    @Test
+    fun acceptsTheSameSecureAuthority() {
+        assertTrue(GatewayUrlPolicy.isPinnedAuthority(origin, "https://192.168.1.11:3443/"))
+        assertTrue(
+            GatewayUrlPolicy.isPinnedAuthority(
+                origin,
+                "wss://192.168.1.11:3443/api/remote.mux",
+            ),
+        )
+    }
+
+    @Test
+    fun acceptsAnExplicitDefaultPortForAnImplicitOriginPort() {
+        val implicit = requireNotNull(GatewayOrigin.parse("https://gateway.example"))
+        assertTrue(GatewayUrlPolicy.isPinnedAuthority(implicit, "wss://gateway.example:443/sidebar/ws"))
+        assertTrue(GatewayUrlPolicy.isPinnedAuthority(implicit, "https://gateway.example/"))
+    }
+
+    @Test
+    fun rejectsAnotherPortOrHost() {
+        assertFalse(
+            GatewayUrlPolicy.isPinnedAuthority(
+                origin,
+                "wss://192.168.1.11:4443/api/remote.mux",
+            ),
+        )
+        assertFalse(
+            GatewayUrlPolicy.isPinnedAuthority(
+                origin,
+                "wss://192.168.1.12:3443/api/remote.mux",
+            ),
+        )
+    }
+
+    @Test
+    fun rejectsCleartextAndUnsupportedSchemes() {
+        assertFalse(GatewayUrlPolicy.isPinnedAuthority(origin, "ws://192.168.1.11:3443/api/remote.mux"))
+        assertFalse(GatewayUrlPolicy.isPinnedAuthority(origin, "http://192.168.1.11:3443/"))
+        assertFalse(GatewayUrlPolicy.isPinnedAuthority(origin, "file:///data/local/tmp/x"))
+        assertFalse(GatewayUrlPolicy.isPinnedAuthority(origin, "not a url"))
+    }
+
+    @Test
+    fun rejectsCredentialsInTheUrl() {
+        assertFalse(
+            GatewayUrlPolicy.isPinnedAuthority(
+                origin,
+                "wss://user:secret@192.168.1.11:3443/api/remote.mux",
+            ),
+        )
+    }
+
+    @Test
+    fun rejectsIpv6LoopbackForAnIpv4Origin() {
+        assertFalse(GatewayUrlPolicy.isPinnedAuthority(origin, "wss://[::1]:3443/api/remote.mux"))
+        val loopback = requireNotNull(GatewayOrigin.parse("https://[::1]:3443"))
+        assertTrue(GatewayUrlPolicy.isPinnedAuthority(loopback, "wss://[::1]:3443/api/remote.mux"))
+        assertNotNull(loopback)
+    }
+}
